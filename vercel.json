{
    "rewrites": [
        {
            "source": "/api/landed-status",
            "destination": "/api/landed?fn=status"
        },
        {
            "source": "/api/landed-portal",
            "destination": "/api/landed?fn=portal"
        },
        {
            "source": "/api/landed-checkout",
            "destination": "/api/landed?fn=checkout"
        },
        {
            "source": "/api/world",
            "destination": "/api/comments?fn=world"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/web/$1"
        }
    ],
    "redirects": [
        {
            "source": "/paths/:rest*",
            "destination": "/",
            "permanent": true
        }
    ]
}
